# Copy to .env and adjust. The agent reads these via the model/ provider seam.
# Local dev / acceptance: an LM Studio server exposing an OpenAI-compatible API.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=google/gemma-4-26b-a4b
LLM_API_KEY=lm-studio

# Any OpenAI-compatible endpoint works — point these at OpenRouter, Ollama, etc.:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-3-27b-it
# LLM_API_KEY=sk-or-...

# Optional, OpenRouter only. Each is sent only when set, so a local endpoint
# (LM Studio, Ollama) sees byte-identical requests either way.
# Ask for a reasoning level from models that have one:
# LLM_REASONING_EFFORT=medium
# Pin the serving base for measurement runs — either pin also disables
# OpenRouter's fallbacks, because a pin that can silently reroute is not a pin:
# LLM_PROVIDER_ORDER=deepinfra
# LLM_QUANTIZATION=fp8
